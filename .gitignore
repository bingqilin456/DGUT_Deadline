# .gitignore —— 确保凭证、会话、个人数据、构建产物绝不入库

# ── 依赖与构建 ──────────────────────────────────────────────
node_modules/
out/
dist/
/build/*
!/build/icon.ico
!/build/icon.png
release/
*.tsbuildinfo
/packages/shared/package-lock.json
.vite/
.electron-vite/

# ── 会话与浏览器 profile（**绝不能入库**）────────────────────
browser-profile/
profile/
profile-*/
**/userDataDir/
*.storage-state.json
*storageState*.json

# ── 凭证 / 环境变量 ─────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets*
credentials*

# ── 调研产物（含真实作业与接口响应，属个人数据）─────────────
investigation/
/PoC/
PoC/profile*/
PoC/**/*.jsonl
evidence/
captures/
har/
*.har
*.har.gz

# ── 诊断导出与日志 ──────────────────────────────────────────
logs/
*.log
dgut-deadline-diagnostics/
diagnostics-*.json

# ── 截图（可能含隐私；文档用图请手动挑选后放入 docs/screenshots）──
temp-screenshots/
*.tmp.png
/docs/screenshots/*
!/docs/screenshots/fluent-1180.png
!/docs/screenshots/fluent-900.png
!/docs/screenshots/fluent-900-table.png
!/docs/screenshots/fluent-720.png
!/docs/screenshots/fluent-590.png
!/docs/screenshots/fluent-light.png
!/docs/screenshots/fluent-settings.png
/docs/acceptance-report.json

# 本地恢复、临时修补脚本（不属于应用源码）
/fix.cjs
/f2.cjs
/r2.cjs
/recovered-hw-class.txt

# ── 编辑器与系统 ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
